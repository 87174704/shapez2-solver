{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shapez2-solver.local/schema/benchmark-instance.v1.schema.json",
  "title": "Shapez 2 Solver Benchmark Instance v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "suite", "track", "targetId", "target", "partition", "inputs", "rules", "provenance", "construction", "witness", "difficulty", "diversity", "instanceSha256"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "minLength": 1 },
    "suite": { "const": "hard" },
    "track": { "enum": ["main", "side"] },
    "targetId": { "type": "string", "pattern": "^hard-(main|side)-[0-9]{3}$" },
    "target": { "$ref": "#/$defs/shapeCode" },
    "partition": { "enum": ["pilot", "development", "validation", "holdout"] },
    "inputs": {
      "description": "Counted available input environment; entries are resources the witness may select, not a mandatory-consumption recipe.",
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["shape", "count"],
        "properties": { "shape": { "$ref": "#/$defs/shapeCode" }, "count": { "type": "integer", "minimum": 1 } }
      }
    },
    "rules": {
      "type": "object", "additionalProperties": false, "required": ["maxLayers", "cleanPainting", "allowSplitting"],
      "properties": { "maxLayers": { "const": 4 }, "cleanPainting": { "type": "boolean" }, "allowSplitting": { "type": "boolean" } }
    },
    "provenance": { "type": "object" },
    "construction": { "type": "object" },
    "witness": {
      "type": "object", "additionalProperties": false, "required": ["initial", "steps", "resultId"],
      "properties": {
        "initial": {
          "description": "Tokens selected for this forward witness; per-shape counts must not exceed the available inputs.",
          "type": "array", "items": { "$ref": "#/$defs/token" }
        },
        "steps": { "type": "array", "items": { "$ref": "#/$defs/step" } },
        "resultId": { "type": "integer", "minimum": 0 }
      }
    },
    "difficulty": { "type": "object" },
    "diversity": { "type": "object" },
    "instanceSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  },
  "$defs": {
    "shapeCode": { "type": "string", "pattern": "^[A-Za-z-]{8}(:[A-Za-z-]{8}){0,3}$" },
    "token": {
      "type": "object", "additionalProperties": false, "required": ["id", "shape"],
      "properties": { "id": { "type": "integer", "minimum": 0 }, "shape": { "$ref": "#/$defs/shapeCode" } }
    },
    "step": {
      "type": "object", "additionalProperties": false, "required": ["operation", "inputs", "outputs", "params"],
      "properties": {
        "operation": { "enum": ["Splitter", "Rotator CW", "Rotator CCW", "Rotator 180", "Half Destroyer", "Cutter", "Swapper", "Stacker", "Painter", "Pin Pusher", "Crystal Generator"] },
        "inputs": { "type": "array", "items": { "type": "integer", "minimum": 0 }, "minItems": 1, "maxItems": 2 },
        "outputs": { "type": "array", "items": { "$ref": "#/$defs/token" } },
        "params": { "type": "object" }
      }
    }
  }
}
