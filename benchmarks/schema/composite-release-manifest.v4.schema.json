{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shapez2-solver.local/schema/composite-release-manifest.v4.schema.json",
  "title": "Provenance-preserving Composite Benchmark Release Manifest v4",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "manifestKind", "manifestRevisionId", "compositeReleaseId",
    "status", "suite", "profileId", "createdAt", "hashCanonicalization",
    "compositeCanonicalSha256", "bindings", "sourceRegistry", "members"
  ],
  "properties": {
    "schemaVersion": { "const": 4 },
    "manifestKind": { "const": "composite-benchmark-release" },
    "manifestRevisionId": { "type": "string", "minLength": 1 },
    "compositeReleaseId": { "type": "string", "minLength": 1 },
    "status": { "enum": ["audit-candidate", "released"] },
    "suite": { "const": "hard" },
    "profileId": { "type": "string", "minLength": 1 },
    "createdAt": { "type": "string", "format": "date-time" },
    "hashCanonicalization": { "const": "canonical-json-v1" },
    "compositeCanonicalSha256": { "$ref": "#/$defs/sha256" },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "finalSelection", "repositoryPolicy", "userRules", "benchmarkRules",
        "officialTargets", "inputCatalog", "inputEnvironmentExpansion",
        "schema", "generator", "validator"
      ],
      "properties": {
        "finalSelection": {
          "type": "object", "additionalProperties": false,
          "required": ["path", "selectionId", "selectionCanonicalSha256", "documentCanonicalSha256"],
          "properties": {
            "path": { "type": "string", "minLength": 1 },
            "selectionId": { "type": "string", "minLength": 1 },
            "selectionCanonicalSha256": { "$ref": "#/$defs/sha256" },
            "documentCanonicalSha256": { "$ref": "#/$defs/sha256" }
          }
        },
        "repositoryPolicy": { "$ref": "#/$defs/canonicalVersionedBinding" },
        "userRules": { "$ref": "#/$defs/fileBinding" },
        "benchmarkRules": { "$ref": "#/$defs/fileBinding" },
        "officialTargets": { "$ref": "#/$defs/canonicalBinding" },
        "inputCatalog": { "$ref": "#/$defs/canonicalBinding" },
        "inputEnvironmentExpansion": { "$ref": "#/$defs/canonicalVersionedBinding" },
        "schema": { "$ref": "#/$defs/versionedFileBinding" },
        "generator": { "$ref": "#/$defs/versionedFileBinding" },
        "validator": { "$ref": "#/$defs/versionedFileBinding" }
      }
    },
    "sourceRegistry": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["sourceId", "path", "contentType", "releaseId", "canonicalSha256"],
        "properties": {
          "sourceId": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "path": { "type": "string", "minLength": 1 },
          "contentType": { "enum": ["benchmark-artifact", "instance-array"] },
          "releaseId": { "type": "string", "minLength": 1 },
          "canonicalSha256": { "$ref": "#/$defs/sha256" },
          "manifestRevisionId": { "type": "string", "minLength": 1 }
        }
      }
    },
    "members": {
      "type": "array", "minItems": 159, "maxItems": 159,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": [
          "targetId", "slot", "familyIdentity", "sourceId", "sourceInstanceId",
          "sourceInstanceSha256", "structuralSignature", "selectionEntrySha256"
        ],
        "properties": {
          "targetId": { "type": "string", "pattern": "^hard-(main|side)-[0-9]{3}$" },
          "slot": { "enum": ["F1", "F2", "F3"] },
          "familyIdentity": { "type": "string", "minLength": 1 },
          "sourceId": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "sourceInstanceId": { "type": "string", "minLength": 1 },
          "sourceInstanceSha256": { "$ref": "#/$defs/sha256" },
          "structuralSignature": { "$ref": "#/$defs/sha256" },
          "selectionEntrySha256": { "$ref": "#/$defs/sha256" }
        }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "fileBinding": {
      "type": "object", "additionalProperties": false, "required": ["path", "sha256"],
      "properties": { "path": { "type": "string", "minLength": 1 }, "sha256": { "$ref": "#/$defs/sha256" } }
    },
    "canonicalBinding": {
      "type": "object", "additionalProperties": false, "required": ["path", "canonicalSha256"],
      "properties": { "path": { "type": "string", "minLength": 1 }, "canonicalSha256": { "$ref": "#/$defs/sha256" } }
    },
    "canonicalVersionedBinding": {
      "type": "object", "additionalProperties": false, "required": ["path", "identity", "version", "canonicalSha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 }, "identity": { "type": "string", "minLength": 1 },
        "version": { "type": "integer", "minimum": 1 }, "canonicalSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "versionedFileBinding": {
      "type": "object", "additionalProperties": false, "required": ["path", "version", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 }, "version": { "type": ["integer", "string"] },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
